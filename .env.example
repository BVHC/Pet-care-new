# ===========================================
# Pet-care-new Environment Configuration
# ===========================================

# Application
APP_NAME=petcare-api
APP_HOST=localhost
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petcare
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_TIMEOUT=30s

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Email (Gmail SMTP — dispatch NotificationTask kênh EMAIL, dùng cho gửi OTP
# đăng ký từ 2026-09-13 khi RULE-01-10 đổi danh tính chính sang email).
# MAIL_PASSWORD PHẢI là Gmail App Password (Google Account > Security > App
# Passwords, yêu cầu bật 2FA) — KHÔNG dùng password Gmail thật.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@petcare.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=noreply@petcare.com

# SMS (for OTP)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway
PAYMENT_GATEWAY_URL=https://sandbox.vnpayment.vn
PAYMENT_GATEWAY_TMN_CODE=your-tmn-code
PAYMENT_GATEWAY_HASH_SECRET=your-hash-secret
PAYMENT_GATEWAY_RETURN_URL=http://localhost:3000/payment/callback

# Frontend
FE_BASE_URL=http://localhost:3000
FE_API_URL=http://localhost:8080/api

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (for file uploads)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_MAX_SIZE=10MB

# SMS OTP Provider (alternative)
SMS_PROVIDER=firebase
FIREBASE_API_KEY=your-firebase-api-key

# Admin credentials (initial setup)
ADMIN_PHONE=0912345678
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

# Business rules
ORDER_RESERVATION_TTL_MINUTES=15
REFUND_WINDOW_DAYS=30
APPOINTMENT_CANCEL_HOURS=2

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/petcare.log
