# ===========================================
# Pet Care — biến môi trường của backend và docker-compose
# ===========================================
# Sao chép thành `.env` ở thư mục gốc repo (đã gitignore): docker compose tự đọc file này.
# Spring Boot KHÔNG tự đọc `.env`: khi chạy `mvn spring-boot:run`, đặt các biến này trong shell/IDE.
# Giá trị dưới đây trùng mặc định đang có trong docker-compose.yml / BE/src/main/resources/application*.yml.
#
# FE không đọc file này: Vite đọc `VITE_API_URL` từ `FE/.env` (loadEnv chạy trong thư mục FE).

# --- Database ------------------------------------------------
# docker compose dùng cho cả container postgres (chỉ khi tạo volume mới) và backend.
DB_NAME=petcare
DB_USERNAME=postgres
DB_PASSWORD=123456
# Chỉ dùng khi chạy BE ngoài Docker (`mvn spring-boot:run`); trong compose backend luôn trỏ `postgres:5432`.
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---------------------------------------------------
# Chỉ dùng khi chạy BE ngoài Docker; trong compose backend luôn trỏ `redis:6379`.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT -----------------------------------------------------
# Bắt buộc: docker-compose.yml không có giá trị mặc định, thiếu biến này thì mọi lệnh
# `docker compose` (kể cả `up -d postgres redis`) đều dừng. Tối thiểu 32 ký tự. Bắt buộc đổi ở môi trường thật.
JWT_SECRET=petcare-256-bit-secret-key-for-jwt-signing-min-32-chars

# --- Email (worker ST20, docs/adr/0012) ---------------------
# Mặc định: Mailpit trong docker-compose (SMTP giả, không xác thực, xem thư ở http://localhost:8025).
# Chạy `mvn spring-boot:run` ngoài Docker: application.yml mặc định localhost:1025 — bật Mailpit bằng
# `docker compose up -d mailpit`.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true,
# MAIL_USERNAME=<gmail>, MAIL_PASSWORD=<App Password, bật 2FA>, MAIL_FROM=<gmail>. Gmail giới hạn ~500 thư/ngày
# (Workspace ~2.000): môi trường thật dùng nhà cung cấp SMTP transactional (SES, SendGrid, Brevo…).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@petcare.local

# --- CORS ----------------------------------------------------
# Danh sách origin, phân tách bằng dấu phẩy.
# Mặc định: compose `http://localhost:3000`; `mvn spring-boot:run` `http://localhost:5173,http://localhost:3000`.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Job dọn phiên đăng nhập (docs/adr/0008) -----------------
# Cron 6 trường theo giờ Việt Nam; "-" để tắt. Chỉ docker compose đọc biến này
# (khi chạy `mvn spring-boot:run` dùng APP_JOBS_SESSION_CLEANUP_CRON). Mặc định 03:00 hằng ngày.
SESSION_CLEANUP_CRON=0 0 3 * * *

# --- Job ST02 dọn tài khoản PENDING quá hạn (docs/adr/0013) --
# Cron 6 trường theo giờ Việt Nam; "-" để tắt. Mặc định mỗi 15 phút.
PENDING_ACCOUNT_CLEANUP_CRON=0 */15 * * * *

# --- Job gửi email ST20 (docs/adr/0012) ----------------------
# Hai luồng: priority (OTP, mật khẩu tạm) quét dày hơn luồng thường. "-" để tắt.
NOTIFICATION_OUTBOX_PRIORITY_CRON=*/5 * * * * *
NOTIFICATION_OUTBOX_CRON=*/10 * * * * *
# Luồng IN_APP (docs/adr/0014): giao thông báo trong app vào bảng notifications, không qua SMTP.
NOTIFICATION_IN_APP_CRON=*/5 * * * * *
# Dọn notification_outbox đã xử lý (docs/adr/0016): SENT > 30 ngày, FAILED > 90 ngày. Mặc định 03:40 hằng ngày.
NOTIFICATION_OUTBOX_CLEANUP_CRON=0 40 3 * * *

# --- Cổng backend khi chạy `mvn spring-boot:run` -------------
# Docker profile luôn dùng 8080.
SERVER_PORT=8081
